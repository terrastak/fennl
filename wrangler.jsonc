// Cloudflare Worker configuration.
//
// Top level = production Worker ("fennl"). Its public hostname is deliberately NOT here: the
// production build adds it from the APP_HOSTNAME variable (see vite.config.ts and CLAUDE.md),
// so production is reachable only on that custom domain.
//
// env.preview = a separate Worker ("fennl-preview") used for pull-request preview links on
// workers.dev. It is bound to the staging database ("fennl-preview"), never the production one.
//
// Databases are found by name, so no database IDs are committed. CI creates a missing database
// and applies migrations before each deploy (see .github/workflows/ci.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fennl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  // Node.js APIs in the Worker. Better Auth uses node:crypto's native scrypt to hash passwords.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // Serve the single-page app for any path that isn't a file, and send /api/* to the Worker first.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  // Secrets (BETTER_AUTH_SECRET, email, Google, Apple) are set by CI and listed with the bindings
  // in worker/env.d.ts. They're deliberately not declared here: declaring them makes local
  // development ignore every optional setting in .dev.vars.
  // Production database. Migrations live in worker/db/migrations and are written by Drizzle.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fennl",
      "migrations_dir": "worker/db/migrations",
    },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      // Staging database, shared by every pull-request preview. Bindings are not inherited from
      // the top level, so this list must name the database explicitly.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fennl-preview",
          "migrations_dir": "worker/db/migrations",
        },
      ],
    },
  },
}
