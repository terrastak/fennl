{
  "title": "Dave's Chili",
  "ingredients": [
    "2 lb ground beef",
    "1 onion, chopped",
    "2 cans (15 oz) kidney beans, drained",
    "1 can (28 oz) crushed tomatoes",
    "2 Tbsp chili powder",
    "1 tsp cumin",
    "1 tsp salt"
  ],
  "directions": [
    "Brown the beef with the onion and drain the fat.",
    "Add everything else and simmer for 1 hour, stirring now and then."
  ],
  "notes": "Even better the next day.",
  "source": { "name": "Dave", "author": null, "page": null }
}
