{
  "title": "Milky Way Cake",
  "ingredients": [
    "8 large Milky Ways",
    "2 sticks butter",
    "1/2 tsp baking soda",
    "1 1/4 cups buttermilk",
    "2 cups sugar",
    "4 eggs",
    "2 1/2 cups flour",
    "1 cup nuts"
  ],
  "directions": ["Melt bars + butter + set aside.", "Cream sugar + eggs + beat.", "Add flour"]
}
