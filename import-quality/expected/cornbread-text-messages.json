{
  "title": "Grandma's Cornbread",
  "ingredients": [
    "1 cup cornmeal",
    "1 cup flour",
    "1/4 cup sugar",
    "1 Tbsp baking powder",
    "1/2 tsp salt",
    "1 cup milk",
    "1 egg",
    "1/4 cup oil"
  ],
  "directions": [
    "Mix the dry things.",
    "Add milk, egg and oil, stir just until mixed.",
    "Bake in a greased 8 inch pan at 400 for 20-25 min."
  ],
  "notes": "",
  "source": { "name": "Mom", "author": null, "page": null }
}
