{
  "title": "Sugar Butter Balls",
  "ingredients": [
    "1 cup butter",
    "1 tsp. vanilla",
    "1/2 cup sifted powdered sugar",
    "2 1/4 cup flour",
    "3/4 cup nuts",
    "1/2 tsp. salt"
  ],
  "directions": ["Mix butter, sugar and vanilla, sift flour and salt, add nuts."],
  "servings": {
    "count": 48,
    "yield": "4 doz."
  }
}
