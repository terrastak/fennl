{
  "name": "fennl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && npm run db:migrate:local && vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typegen": "wrangler types --include-env=false",
    "typecheck": "npm run typegen && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "auth:generate": "auth generate --config worker/auth/cli.ts --output worker/db/auth-schema.ts --yes && prettier --write worker/db/auth-schema.ts",
    "db:check": "drizzle-kit check && node scripts/check-migrations.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.7",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "^1.7.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  },
  "allowScripts": {
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
