{
  "manifest_version": 3,
  "name": "Fennl",
  "short_name": "Fennl",
  "description": "Import recipes into your Fennl recipe box from the pages you visit. Needs a Fennl account.",
  "version": "0.3.1",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Fennl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["__FENNL_ORIGIN__/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["__FENNL_ORIGIN__/connect-extension*"],
      "js": ["connect.js"],
      "run_at": "document_start"
    }
  ]
}
